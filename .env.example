# =============================================================================
# StableCoinX environment template
# Copy to /.env (and optionally /frontend/.env for Vite). Do not commit secrets.
# Backend Settings() reads `.env` then `../.env` from the backend working directory.
# =============================================================================

# --- App ---
# Allowed: development | demo | staging | production
APP_ENV=development
ENVIRONMENT=development
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
ALLOWED_ORIGINS=

# --- Database (required) ---
# Local fallback used when Postgres is unavailable: sqlite:///./stablecoinx.db
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/stablecoinx

# --- Auth / JWT (required; JWT_SECRET_KEY must be >= 32 characters) ---
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Supabase (required by Settings; backend login is local JWT if DB users exist) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SERVICE_KEY=

# --- Blockchain RPC (BASE_SEPOLIA_RPC_URL required) ---
ALCHEMY_API_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
BASE_SEPOLIA_CHAIN_ID=84532
POLYGON_AMOY_CHAIN_ID=80002

# --- Backend signer (required). Use a dedicated TESTNET key only. Never a mainnet key. ---
BACKEND_WALLET_PRIVATE_KEY=
BACKEND_WALLET_ADDRESS=

# --- Canonical contract addresses (required at startup via validate_config) ---
CONTRACT_ADDRESS_SETTLEMENT=
CONTRACT_ADDRESS_COMPLIANCE=
CONTRACT_ADDRESS_TREASURY=
CONTRACT_ADDRESS_REGISTRY=

# --- Legacy aliases (filled from canonical names if empty, and vice versa) ---
PAYMENT_AUTHORIZATION_ADDRESS=
SETTLEMENT_PROOF_REGISTRY_ADDRESS=
POLICY_REGISTRY_ADDRESS=
MOCK_USDC_ADDRESS=
MOCK_USDT_ADDRESS=

# Forge output relative to repo root. If missing, backend falls back to contracts/abis/*.json
CONTRACT_ABI_PATH=contracts/out
CONTRACT_ABI_ARTIFACT_MAP=

# --- AI (required by Settings; Ollama/Groq degrade at runtime if unreachable) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma:2b
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# --- Optional infra (required as strings by Settings; services degrade if unreachable) ---
REDIS_URL=redis://localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_USER=
NEO4J_PASSWORD=changeme
TELEGRAM_BOT_TOKEN=disabled
TELEGRAM_CHAT_ID=0

# --- Privacy (optional; current ZK/FHE implementations are in-process simulations) ---
ZK_PROVER_URL=http://localhost:3001
FHE_GATEWAY_URL=http://localhost:3002

# --- Treasury defaults ---
TREASURY_DAILY_LIMIT=500000
PAYROLL_BATCH_CAP=50000

# --- Compliance provider (optional; defaults to the built-in local fixtures) ---
# Set COMPLIANCE_PROVIDER=beeceptor and BEECEPTOR_BASE_URL to your Beeceptor mock
# server (e.g. https://your-mock.free.beeceptor.com) to screen payments against a
# real external endpoint instead of the deterministic local fixtures. Configure a
# rule in your Beeceptor workspace for POST /compliance/screen — see
# docs/SPONSOR_INTEGRATIONS.md for the exact request/response contract. Any
# timeout, non-2xx, or malformed response is treated as a provider outage and
# routes the payment to manual review rather than a silent pass.
COMPLIANCE_PROVIDER=local
BEECEPTOR_BASE_URL=
BEECEPTOR_TIMEOUT_SECONDS=5

# --- n8n operations automation (optional; defaults to disabled) ---
# Set N8N_WEBHOOK_URL to a local or hosted n8n webhook (e.g.
# http://localhost:5678/webhook/certapay-events) to fire payment.blocked /
# manual_review_required / settlement.executed events at n8n, which routes
# them to email via its own Send Email node — see docs/SPONSOR_INTEGRATIONS.md.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TIMEOUT_SECONDS=5

# --- Obfuscation Intelligence external attribution provider (optional) ---
# "none" (default) or "beeceptor". Beeceptor mocks an external attribution
# source (like Chainalysis/TRM) — a separate signal from the classifier's own
# structure-based output, never blended into one score. See
# docs/OBFUSCATION_INTELLIGENCE_DEMO.md.
OBFUSCATION_PROVIDER_MODE=none
BEECEPTOR_OBFUSCATION_URL=
BEECEPTOR_OBFUSCATION_TIMEOUT_SECONDS=5

# --- Frontend-only (place in /frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_WALLETCONNECT_PROJECT_ID=
VITE_ALCHEMY_API_KEY=
VITE_BASE_SEPOLIA_RPC=
VITE_BASE_SEPOLIA_RPC_URL=
VITE_POLYGON_AMOY_RPC_URL=
