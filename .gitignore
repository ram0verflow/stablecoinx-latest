# Environment — never commit secrets
.env
*.env
!.env.example

# Node
node_modules/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/

# SQLite databases — contain local data, not for repo
*.db
*.sqlite
*.sqlite3

# Local n8n instance data (runtime DB, credentials, cache) — never commit
.n8n-local/

# Ad-hoc Playwright verification scripts/screenshots — not part of the app
frontend/.scratchshots/

# Foundry build artifacts
out/
cache/

# Contract dependencies (use forge install to restore)
contracts/lib/

# Build output
dist/
build/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log
/tmp/

# Test artifacts
.coverage
htmlcov/

# Generated audit-report PDF exports (backend/app/services/reports)
backend/*.pdf
