# Backend copy of the root template. Prefer a single repo-root /.env.
# See /.env.example for the full list of variables Settings() expects.

APP_ENV=development
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/stablecoinx
